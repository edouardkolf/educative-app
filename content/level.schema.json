{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "level.schema.json",
  "title": "Niveau",
  "description": "Un niveau de jeu. Ajouter un niveau = créer un fichier content/levels/<parcours>/<id>.json puis l'ajouter au parcours (content/tracks/<parcours>.json).",
  "type": "object",
  "required": ["id", "title", "skill", "objective", "mechanic", "rounds", "params"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Identifiant unique, identique au nom du fichier sans .json (ex. ms-suite-01)."
    },
    "title": { "type": "string", "minLength": 1, "description": "Titre lisible par le parent." },
    "skill": {
      "enum": ["patterns", "counting", "visual-discrimination", "categorization", "color-mixing", "shapes", "comparison", "addition", "subtraction", "multiplication", "spelling", "reading"],
      "description": "Compétence visée : patterns = algorithmes/suites, counting = dénombrement, visual-discrimination = repérer une différence, categorization = trier par catégorie, color-mixing = mélanger des couleurs primaires, shapes = reconnaître des formes géométriques et les placer, comparison = comparer des nombres (<, =, >), addition, subtraction, multiplication = tables, spelling = orthographe des mots invariables, reading = lire une phrase et montrer l'image."
    },
    "objective": { "type": "string", "minLength": 1, "description": "Objectif pédagogique en une phrase, lisible par le parent." },
    "mechanic": { "enum": ["sequence", "count", "odd-one-out", "color-mix", "sort", "builder", "compare", "calc", "spelling", "read"], "description": "Mécanique de jeu. Détermine la forme de params." },
    "rounds": { "type": "integer", "minimum": 3, "maximum": 10, "description": "Nombre de manches dans le niveau." },
    "tutorial": { "type": "boolean", "description": "Affiche la main animée qui montre le geste pendant la première manche." },
    "stars": {
      "type": "object",
      "description": "Seuils d'étoiles en nombre de manches ratées au premier essai. Défaut : 0 raté = 3 étoiles, 1 raté = 2 étoiles, sinon 1.",
      "required": ["maxMissesFor3", "maxMissesFor2"],
      "additionalProperties": false,
      "properties": {
        "maxMissesFor3": { "type": "integer", "minimum": 0 },
        "maxMissesFor2": { "type": "integer", "minimum": 0 }
      }
    },
    "audio": {
      "type": "object",
      "description": "Réservé aux consignes audio (V2). Laisser absent ou vide en V1.",
      "additionalProperties": false,
      "properties": {
        "instruction": { "type": "string", "description": "Chemin d'un fichier audio de consigne (V2)." }
      }
    },
    "params": { "type": "object", "description": "Paramètres de difficulté, propres à la mécanique." }
  },
  "allOf": [
    {
      "if": { "type": "object", "properties": { "mechanic": { "const": "sequence" } } },
      "then": { "type": "object", "properties": { "params": { "$ref": "#/definitions/sequenceParams" } } }
    },
    {
      "if": { "type": "object", "properties": { "mechanic": { "const": "count" } } },
      "then": { "type": "object", "properties": { "params": { "$ref": "#/definitions/countParams" } } }
    },
    {
      "if": { "type": "object", "properties": { "mechanic": { "const": "odd-one-out" } } },
      "then": { "type": "object", "properties": { "params": { "$ref": "#/definitions/oddOneOutParams" } } }
    },
    {
      "if": { "type": "object", "properties": { "mechanic": { "const": "color-mix" } } },
      "then": { "type": "object", "properties": { "params": { "$ref": "#/definitions/colorMixParams" } } }
    },
    {
      "if": { "type": "object", "properties": { "mechanic": { "const": "sort" } } },
      "then": { "type": "object", "properties": { "params": { "$ref": "#/definitions/sortParams" } } }
    },
    {
      "if": { "type": "object", "properties": { "mechanic": { "const": "builder" } } },
      "then": { "type": "object", "properties": { "params": { "$ref": "#/definitions/builderParams" } } }
    },
    {
      "if": { "type": "object", "properties": { "mechanic": { "const": "compare" } } },
      "then": { "type": "object", "properties": { "params": { "$ref": "#/definitions/compareParams" } } }
    },
    {
      "if": { "type": "object", "properties": { "mechanic": { "const": "calc" } } },
      "then": { "type": "object", "properties": { "params": { "$ref": "#/definitions/calcParams" } } }
    },
    {
      "if": { "type": "object", "properties": { "mechanic": { "const": "spelling" } } },
      "then": { "type": "object", "properties": { "params": { "$ref": "#/definitions/spellingParams" } } }
    },
    {
      "if": { "type": "object", "properties": { "mechanic": { "const": "read" } } },
      "then": { "type": "object", "properties": { "params": { "$ref": "#/definitions/readParams" } } }
    }
  ],
  "definitions": {
    "color": { "enum": ["red", "blue", "yellow", "green", "purple", "orange"] },
    "shape": { "enum": ["circle", "square", "triangle", "star", "heart", "diamond"] },
    "category": { "enum": ["fruit", "animal", "vehicle", "toy", "plant"] },
    "figureId": { "enum": ["house", "tree", "boat", "car", "rocket", "fish", "robot", "snowman", "castle"] },
    "objectId": {
      "enum": [
        "apple", "banana", "pear", "strawberry", "cherries", "grapes",
        "dog", "cat", "rabbit", "fish", "bird", "ladybug",
        "car", "bus", "bike", "boat", "train", "tractor",
        "ball", "teddy", "balloon", "kite", "yoyo", "drum",
        "sunflower", "tulip", "cactus", "tree", "fir", "clover",
        "cow", "pig", "sheep", "chicken", "horse",
        "crab", "octopus", "whale", "dolphin", "tropical-fish",
        "butterfly", "bee", "owl"
      ]
    },
    "sequenceParams": {
      "type": "object",
      "description": "Compléter une suite.",
      "required": ["pattern", "vary", "length", "blank", "choices"],
      "additionalProperties": false,
      "properties": {
        "pattern": { "type": "string", "pattern": "^[A-D]{2,6}$", "description": "Motif répété ; chaque lettre = un élément distinct (AB, AAB, ABB, ABC, AABB…)." },
        "vary": { "enum": ["color", "shape", "both", "object"], "description": "Ce qui distingue les éléments du motif. object = émojis (animaux, plantes…) plutôt que forme/couleur." },
        "colors": { "type": "array", "items": { "$ref": "#/definitions/color" }, "minItems": 1, "uniqueItems": true, "description": "Réservoir de couleurs (requis si vary ≠ object)." },
        "shapes": { "type": "array", "items": { "$ref": "#/definitions/shape" }, "minItems": 1, "uniqueItems": true, "description": "Réservoir de formes (requis si vary ≠ object)." },
        "objects": { "type": "array", "items": { "$ref": "#/definitions/objectId" }, "minItems": 1, "uniqueItems": true, "description": "Réservoir d'objets (requis, et utilisé uniquement, si vary = object)." },
        "length": { "type": "integer", "minimum": 4, "maximum": 10, "description": "Nombre total de cases, case à compléter comprise." },
        "blank": { "enum": ["end", "middle"], "description": "end = continuer la suite ; middle = combler un trou." },
        "choices": { "type": "integer", "minimum": 2, "maximum": 4, "description": "Nombre de propositions." }
      },
      "allOf": [
        {
          "if": { "properties": { "vary": { "const": "object" } } },
          "then": { "required": ["objects"] },
          "else": { "required": ["colors", "shapes"] }
        }
      ]
    },
    "countParams": {
      "type": "object",
      "description": "Compter des objets et taper le bon nombre.",
      "required": ["min", "max", "objects", "layout", "choices", "answers"],
      "additionalProperties": false,
      "properties": {
        "min": { "type": "integer", "minimum": 1, "maximum": 10 },
        "max": { "type": "integer", "minimum": 1, "maximum": 10 },
        "objects": { "type": "array", "items": { "$ref": "#/definitions/objectId" }, "minItems": 1, "uniqueItems": true, "description": "Objets possibles (un type d'objet par manche)." },
        "layout": { "enum": ["line", "scatter", "dice"], "description": "line = alignés ; scatter = éparpillés ; dice = constellations de dé (max 6)." },
        "choices": { "type": "integer", "minimum": 2, "maximum": 4, "description": "Nombre de propositions." },
        "answers": { "enum": ["digits", "dots", "digits+dots"], "description": "Présentation des réponses." }
      }
    },
    "oddOneOutParams": {
      "type": "object",
      "description": "Trouver l'intrus.",
      "required": ["items", "differBy", "distract"],
      "additionalProperties": false,
      "properties": {
        "items": { "type": "integer", "minimum": 3, "maximum": 6, "description": "Nombre d'éléments affichés, intrus compris." },
        "differBy": { "enum": ["color", "shape", "category"], "description": "En quoi l'intrus diffère." },
        "colors": { "type": "array", "items": { "$ref": "#/definitions/color" }, "minItems": 2, "uniqueItems": true },
        "shapes": { "type": "array", "items": { "$ref": "#/definitions/shape" }, "minItems": 2, "uniqueItems": true },
        "categories": { "type": "array", "items": { "$ref": "#/definitions/category" }, "minItems": 2, "uniqueItems": true },
        "distract": { "type": "boolean", "description": "Plus difficile : les autres éléments varient sur une autre dimension." }
      }
    },
    "colorMixParams": {
      "type": "object",
      "description": "Le laboratoire des couleurs : mélanger deux fioles pour obtenir la couleur cible.",
      "required": ["targets"],
      "additionalProperties": false,
      "properties": {
        "targets": {
          "type": "array",
          "items": { "$ref": "#/definitions/color" },
          "minItems": 1,
          "uniqueItems": true,
          "description": "Couleurs cibles proposées (une couleur primaire cible se réalise en versant deux fois la même fiole)."
        }
      }
    },
    "sortParams": {
      "type": "object",
      "description": "Le trieur magique : ranger un objet dans le bon panier parmi 2 ou 3 familles.",
      "required": ["groups"],
      "additionalProperties": false,
      "properties": {
        "groups": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "description": "Paniers, dans l'ordre d'affichage fixe (positions stables d'un niveau à l'autre).",
          "items": {
            "type": "object",
            "required": ["id", "symbol", "objects"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
              "symbol": { "type": "string", "minLength": 1, "description": "Émoji géant affiché sur le panier." },
              "objects": {
                "type": "array",
                "items": { "$ref": "#/definitions/objectId" },
                "minItems": 2,
                "uniqueItems": true
              }
            }
          }
        }
      }
    },
    "builderParams": {
      "type": "object",
      "description": "Le constructeur : rebâtir une figure en plaçant les bonnes pièces sur leurs emplacements.",
      "required": ["figures", "distractors"],
      "additionalProperties": false,
      "properties": {
        "figures": {
          "type": "array",
          "items": { "$ref": "#/definitions/figureId" },
          "minItems": 1,
          "description": "Figures à construire (cycle sans répétition tant que le réservoir n'est pas épuisé)."
        },
        "distractors": { "type": "integer", "minimum": 0, "maximum": 2, "description": "Pièces en trop, qui ne correspondent à aucun emplacement." }
      }
    },
    "compareForm": {"enum": ["numbers", "sum-vs-number", "sums"]},
    "intRange": {"type": "object", "required": ["min", "max"], "additionalProperties": false, "properties": {"min": {"type": "integer", "minimum": 0, "maximum": 999}, "max": {"type": "integer", "minimum": 0, "maximum": 999}}},
    "wordId": {"enum": ["apres", "aupres", "aussi", "aussitot", "assez", "afin", "aujourdhui", "autour", "autant", "autrefois"]},
    "compareParams": {
      "type": "object",
      "description": "Comparer deux quantités écrites et taper <, = ou >.",
      "required": ["min", "max", "form", "equalRate"],
      "additionalProperties": false,
      "properties": {
        "min": {"type": "integer", "minimum": 0, "maximum": 999},
        "max": {"type": "integer", "minimum": 0, "maximum": 999},
        "form": {"oneOf": [{"$ref": "#/definitions/compareForm"}, {"type": "array", "items": {"$ref": "#/definitions/compareForm"}, "minItems": 1}], "description": "numbers : 47 ? 52 ; sum-vs-number : 8 + 5 ? 12 ; sums : 8 + 5 ? 6 + 7. Une liste : les formes alternent d'une manche à l'autre."},
        "equalRate": {"type": "number", "minimum": 0, "maximum": 0.5, "description": "Part approximative de manches à égalité."},
        "maxGap": {"type": "integer", "minimum": 1, "description": "Écart maximal entre les deux côtés quand ils diffèrent."}
      }
    },
    "calcParams": {
      "type": "object",
      "description": "Calcul : addition, soustraction, tables de multiplication.",
      "required": ["operation", "a", "b", "unknown", "answer"],
      "additionalProperties": false,
      "properties": {
        "operation": {"enum": ["add", "sub", "mul"]},
        "a": {"$ref": "#/definitions/intRange"},
        "b": {"$ref": "#/definitions/intRange"},
        "carry": {"enum": ["any", "with", "without"], "description": "add : retenue ; sub : emprunt. Ignoré en mul."},
        "unknown": {"enum": ["result", "operand"], "description": "result : 7 + 5 = ? ; operand : 7 + ? = 12."},
        "answer": {"enum": ["choices", "keypad"]},
        "choices": {"type": "integer", "minimum": 3, "maximum": 4},
        "showArray": {"type": "boolean", "description": "mul : quadrillage de points en appui."},
        "maxProduct": {"type": "integer", "minimum": 1, "description": "mul : produit maximal (16 = jusqu'à 4 × 4 et 3 × 5, sans 4 × 5)."}
      }
    },
    "spellingParams": {
      "type": "object",
      "description": "Orthographe des mots invariables.",
      "required": ["words", "mode", "sentence"],
      "additionalProperties": false,
      "properties": {
        "words": {"type": "array", "items": {"$ref": "#/definitions/wordId"}, "minItems": 1, "uniqueItems": true},
        "mode": {"enum": ["pick", "gap", "tiles"], "description": "pick : bonne orthographe parmi des variantes ; gap : lettres manquantes ; tiles : reconstituer le mot."},
        "sentence": {"type": "boolean", "description": "Affiche une phrase d'exemple avec le mot en trou."},
        "choices": {"type": "integer", "minimum": 2, "maximum": 4},
        "extraTiles": {"type": "integer", "minimum": 0, "maximum": 4},
        "closeness": {"enum": [1, 2, 3], "description": "pick : proximité des variantes fautives — 1 grossières, 2 moyennes, 3 subtiles (un accent, une lettre)."}
      }
    },
    "readParams": {
      "type": "object",
      "description": "Lis et montre : lire une ou deux phrases, taper l'image qui correspond.",
      "required": ["traps", "relations", "sentences", "choices"],
      "additionalProperties": false,
      "properties": {
        "traps": {"type": "array", "items": {"enum": ["noun", "number", "position", "negation"]}, "minItems": 1, "uniqueItems": true, "description": "Ce que les images fausses changent : noun = nom qui ressemble (lapin/sapin), number = un/plusieurs, position = sur/sous…, negation = phrases négatives."},
        "relations": {"type": "array", "items": {"enum": ["on", "under", "beside", "in-front"]}, "minItems": 1, "uniqueItems": true, "description": "on = sur, under = sous, beside = à côté de, in-front = devant."},
        "sentences": {"type": "integer", "minimum": 1, "maximum": 2},
        "choices": {"type": "integer", "minimum": 3, "maximum": 4}
      }
    }
  }
}
